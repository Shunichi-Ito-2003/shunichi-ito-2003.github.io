---
const currentPath = Astro.url.pathname;
const isEn = currentPath.startsWith('/en');
const prefix = isEn ? '/en' : '';
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-cream-dark)] py-12 px-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-center md:text-left">
      <p class="font-display text-sm tracking-[0.2em] text-[var(--color-ink)] mb-1">ITO SHUNICHI</p>
      <p class="font-japanese text-xs text-[var(--color-ink-muted)]">
        {isEn ? 'Actor / Medical Student / Okinawa' : '俳優 / 医学生 / 沖縄'}
      </p>
    </div>

    <nav class="flex items-center gap-6">
      <a href={isEn ? '/en/' : '/'} class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] hover:text-[var(--color-gold)] transition-colors">HOME</a>
      <a href={`${prefix}/blog`} class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] hover:text-[var(--color-gold)] transition-colors">BLOG</a>
      <a href={`${prefix}/about`} class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] hover:text-[var(--color-gold)] transition-colors">PROFILE</a>
      <a href={`${prefix}/#contact`} class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] hover:text-[var(--color-gold)] transition-colors">CONTACT</a>
    </nav>

    <p class="font-display text-xs tracking-widest text-[var(--color-ink-muted)]">
      &copy; {new Date().getFullYear()} ITO SHUNICHI
    </p>
  </div>

  <div class="max-w-6xl mx-auto mt-8 pt-6 border-t border-[var(--color-border)] text-center">
    <p class="font-japanese text-xs text-[var(--color-ink-muted)] leading-relaxed mb-3">
      {isEn ? 'Who is Ichi? An AI trained on all my note articles answers anything about my work.' : '「いっちーってどんな人？」note記事を読み込んだAIが、活動のことに何でも答えます。'}
    </p>
    <a
      href="https://notebooklm.google.com/notebook/d1217e51-8352-4733-9311-d410ad584356"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-6 py-2 border border-[var(--color-gold)] text-[var(--color-gold)] font-display text-[11px] tracking-[0.2em] hover:bg-[var(--color-gold)] hover:text-white transition-all duration-300"
    >
      {isEn ? 'Ask Ichi AI' : 'いっちーAIに質問する'}
    </a>
  </div>
</footer>
