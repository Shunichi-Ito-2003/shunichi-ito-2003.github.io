---
import Layout from '../../layouts/Layout.astro';
import { getPostsByKeyword } from '../../lib/posts';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/写真、画像/**/*.{jpg,JPG,jpeg,JPEG,png,PNG}'
, { eager: true });

const imgMap: Record<string, ImageMetadata> = {};
for (const [fullPath, mod] of Object.entries(allImages)) {
  imgMap[fullPath.replace('/src/assets', '')] = mod.default;
}

const relatedPosts = getPostsByKeyword('一人芝居').slice(0, 8);

const highlights = [
  { date: '2025.02', text: '「一人で芝居をやる」という決意。作・演出・出演すべてひとりで挑む' },
  { date: '2025.03', text: '脚本執筆開始。自分の内側にあるものと向き合いながら言葉を紡ぐ' },
  { date: '2025.04', text: '北谷モッズにて初演。88名満員の会場で一人芝居を届ける' },
  { date: '2026〜', text: '「出張一人芝居」始動。沖縄本島内どこへでも、1名から上演' },
];
---

<Layout
  title="伊藤駿一の奇劇"
  description="伊藤駿一の一人芝居『伊藤駿一の奇劇』。作・演出・出演すべてひとりで手がける舞台。北谷モッズにて88名満員で初演。沖縄本島内どこへでも出張上演中。"
>
  <!-- Hero -->
  <section class="relative h-[70vh] overflow-hidden bg-[var(--color-ink)]">
    <Image src={imgMap['/写真、画像/一人芝居/劇中の僕.JPG']} alt="伊藤駿一の奇劇" width={1920} loading="eager" class="w-full h-full object-cover" style="object-position: 50% 18%" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 p-8 md:p-16 max-w-4xl">
      <a href="/works" class="font-display text-xs tracking-[0.2em] text-white/50 hover:text-[var(--color-gold)] transition-colors mb-6 block">← WORKS</a>
      <span class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] block mb-3">SOLO PERFORMANCE · 2025〜</span>
      <h1 class="font-japanese text-4xl md:text-6xl font-bold text-white leading-tight mb-4">伊藤駿一の奇劇</h1>
      <p class="font-japanese text-white/70 text-lg leading-relaxed">
        作・演出・出演、すべてひとりで
      </p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6 py-16 space-y-20">

    <!-- Overview -->
    <section class="fade-in grid md:grid-cols-[1fr_280px] gap-12">
      <div class="space-y-6">
        <div>
          <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">OVERVIEW</p>
          <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-6">作品について</h2>
        </div>
        <div class="space-y-4 font-japanese text-[var(--color-ink-muted)] leading-loose text-justify">
          <p>
            脚本を書き、演出を考え、舞台に立つ——すべてをひとりで担う一人芝居。
            役者として「演じる」だけでなく、「創る」という行為を通じて、
            舞台と客席の間に生まれるものを探求しています。
          </p>
          <p>
            2025年4月、北谷モッズにて初演。88名の観客を前に、ひとりの人間が紡ぐ物語を届けました。
          </p>
          <p>
            2026年からは「<strong class="text-[var(--color-ink)]">出張一人芝居</strong>」として、
            沖縄本島内であればどこへでも、1名からでも上演します。
            演劇を「特別な場所に行かなければ見られないもの」ではなく、
            日常の中に届けたい——という思いから生まれた活動です。
          </p>
        </div>
      </div>

      <div class="border border-[var(--color-border)] divide-y divide-[var(--color-border)] h-fit">
        {[
          { label: 'ROLE', value: '作・演出・出演（すべて伊藤駿一）' },
          { label: 'PREMIERE', value: '2025年4月 北谷モッズ（88名満員）' },
          { label: 'FORMAT', value: '出張一人芝居（2026年〜）' },
          { label: 'AREA', value: '沖縄本島内 / 1名〜' },
        ].map((item) => (
          <div class="px-5 py-3">
            <p class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] mb-0.5">{item.label}</p>
            <p class="font-japanese text-sm text-[var(--color-ink)]">{item.value}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- My role -->
    <section class="fade-in border-l-2 border-[var(--color-gold)] pl-8 space-y-4">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)]">MY ROLE</p>
      <h2 class="font-japanese text-xl font-bold text-[var(--color-ink)]">「創る」という行為が、「演じる」を深める</h2>
      <div class="space-y-4 font-japanese text-[var(--color-ink-muted)] leading-loose text-justify">
        <p>
          一人芝居は、ただ「演じる」だけでは完結しません。
          どんな物語を選ぶか、どの言葉が必要か、空間をどう使うか——
          すべての選択が自分に問いかけてくる作業です。
        </p>
        <p>
          脚本を書くことで初めて気づいた登場人物の感情、
          演出を考えながら発見した舞台の可能性。
          それらが「演じる」という行為を、より深く豊かなものにしてくれました。
        </p>
        <p>
          「演劇は世界を平和にする」という信念は、劇場の舞台だけに留まらない。
          誰かの日常の中に届ける一人芝居は、その実践です。
        </p>
      </div>
    </section>

    <!-- Flyer -->
    <section class="fade-in">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">FLYER</p>
      <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-6">公演フライヤー</h2>
      <div class="flex justify-center">
        <Image
          src={imgMap['/写真、画像/一人芝居/伊藤駿一の奇劇_フライヤー_初めての一人芝居.PNG']}
          alt="伊藤駿一の奇劇 フライヤー"
          width={768}
          class="max-w-sm w-full border border-[var(--color-border)]"
        />
      </div>
    </section>

    <!-- Gallery -->
    <section class="fade-in">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">GALLERY</p>
      <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-6">公演写真</h2>
      <div class="grid grid-cols-1 gap-4">
        <Image
          src={imgMap['/写真、画像/一人芝居/劇中の僕.JPG']}
          alt="伊藤駿一の奇劇 劇中"
          width={1200}
          class="w-full border border-[var(--color-border)]"
        />
      </div>
    </section>

    <!-- Video -->
    <section class="fade-in border border-[var(--color-border)] p-8 text-center space-y-3">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)]">VIDEO</p>
      <p class="font-japanese text-[var(--color-ink-muted)] text-sm leading-relaxed">
        公演映像はお問い合わせください
      </p>
      <a
        href="mailto:changeupandshake@gmail.com"
        class="inline-block font-display text-xs tracking-[0.2em] text-[var(--color-gold)] hover:underline"
      >
        CONTACT →
      </a>
    </section>

    <!-- Timeline -->
    <section class="fade-in">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">TIMELINE</p>
      <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-8">記録</h2>
      <div class="relative pl-6 border-l-2 border-[var(--color-border)] space-y-0">
        {highlights.map((h) => (
          <div class="relative py-5 group">
            <div class="absolute -left-[1.45rem] top-7 w-3 h-3 rounded-full border-2 border-[var(--color-gold)] bg-white group-hover:bg-[var(--color-gold)] transition-colors"></div>
            <time class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] block mb-1">{h.date}</time>
            <p class="font-japanese text-[var(--color-ink)] leading-relaxed">{h.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related posts -->
    {relatedPosts.length > 0 && (
      <section class="fade-in">
        <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">DOCUMENT</p>
        <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-8">制作日誌</h2>
        <div class="divide-y divide-[var(--color-border)]">
          {relatedPosts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="group flex gap-6 py-5 hover:bg-[var(--color-cream)] px-2 -mx-2 transition-colors"
            >
              <time class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] shrink-0 pt-1 w-24">{post.date}</time>
              <h3 class="font-japanese text-[var(--color-ink)] group-hover:text-[var(--color-gold-dark)] transition-colors leading-relaxed line-clamp-2">
                {post.title}
              </h3>
              <span class="shrink-0 self-center font-display text-xs text-[var(--color-gold)] opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </a>
          ))}
        </div>
        <div class="mt-6">
          <a href="/blog" class="font-display text-xs tracking-[0.2em] text-[var(--color-ink-muted)] hover:text-[var(--color-gold)] transition-colors">
            すべての記事を読む →
          </a>
        </div>
      </section>
    )}
  </div>
</Layout>
