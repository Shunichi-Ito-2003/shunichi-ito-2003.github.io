---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/写真、画像/**/*.{jpg,JPG,jpeg,JPEG,png,PNG}'
, { eager: true });

const imgMap: Record<string, ImageMetadata> = {};
for (const [fullPath, mod] of Object.entries(allImages)) {
  imgMap[fullPath.replace('/src/assets', '')] = mod.default;
}
---

<Layout title="PROFILE" description="伊藤駿一のプロフィール。俳優・医学生として沖縄を拠点に活動。">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">プロフィール</p>
      <h1 class="font-display text-4xl md:text-5xl tracking-[0.15em] text-[var(--color-ink)] mb-6">PROFILE</h1>
      <div class="h-px w-16 bg-[var(--color-gold)]"></div>
    </header>

    <!-- Section: The Actor -->
    <section class="grid md:grid-cols-2 gap-12 items-start mb-20">
      <div class="space-y-6">
        <h2 class="font-display text-xl tracking-[0.2em] text-[var(--color-gold)] flex items-center gap-4">
          <span class="h-px w-8 bg-[var(--color-gold)] inline-block"></span>
          THE ACTOR
        </h2>
        <div class="space-y-5 font-japanese text-[var(--color-ink-muted)] leading-loose text-justify">
          <p>
            「演劇は世界を平和にする」という信念のもと、沖縄を拠点に俳優として活動しています。
            演劇を通して自分が押し殺していた感情を知るだけで、ふっと肩の力が抜けることがある。
            その体験を、もっと多くの人に届けたい——それがこの道に入った理由です。
          </p>
          <p>
            医学部で生命と向き合う日々が、舞台に立つ自分を変えていきました。
            解剖学で人体の精緻さを知り、臨床で「生老病死」の現場に立ち会うことで、
            人間という存在の複雑さへの解像度が上がっていく感覚があります。
            医学と演劇、この二つはどちらも「人間の救済」を目指しているという点で、僕の中では地続きです。
          </p>
          <p>
            2024年、カンヌ国際映画祭の現地を訪れ、そのエネルギーに圧倒されました。
            「今度は作品といっしょにこの地に立つ」という決意を胸に、日々邁進しています。
          </p>
          <div class="border-l-2 border-[var(--color-gold)] pl-5 mt-6">
            <p class="font-display text-xs tracking-[0.2em] text-[var(--color-gold)] mb-2">GOAL</p>
            <p class="font-japanese text-[var(--color-ink)] font-bold">カンヌ国際映画祭 主演男優賞</p>
          </div>
        </div>
      </div>

      <!-- Photo -->
      <div class="aspect-[3/4] overflow-hidden border border-[var(--color-border)]">
        <Image
          src={imgMap['/写真、画像/my portfolio/about-actor.jpeg']}
          alt="ITO SHUNICHI - Actor"
          width={600}
          class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-700"
        />
      </div>
    </section>

    <!-- Section: The Student -->
    <section class="grid md:grid-cols-2 gap-12 items-start mb-20">
      <!-- Photo -->
      <div class="aspect-[3/4] overflow-hidden border border-[var(--color-border)] order-2 md:order-1">
        <Image
          src={imgMap['/写真、画像/my portfolio/about-student.jpg']}
          alt="ITO SHUNICHI - Student"
          width={600}
          class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-700"
        />
      </div>

      <div class="space-y-6 order-1 md:order-2">
        <h2 class="font-display text-xl tracking-[0.2em] text-[var(--color-gold)] flex items-center gap-4">
          <span class="h-px w-8 bg-[var(--color-gold)] inline-block"></span>
          THE STUDENT
        </h2>
        <div class="space-y-5 font-japanese text-[var(--color-ink-muted)] leading-loose text-justify">
          <p>
            普段は医学部に通い、生命の仕組みと向き合っています。「論理」と「生命」の世界に身を置くことで、世界を客観的に捉える視座を養っています。
          </p>
        </div>

        <!-- Info table -->
        <div class="border border-[var(--color-border)] divide-y divide-[var(--color-border)]">
          {[
            { label: 'Name', value: '伊藤 駿一（Shunichi Ito）' },
            { label: 'Born', value: '2003年4月18日　沖縄県出身' },
            { label: 'Agency', value: '01ENTERTAINMENT' },
            { label: 'Univ.', value: '琉球大学 医学部 医学科' },
            { label: 'Height', value: '180 cm' },
            { label: 'Sizes', value: 'B86 / W74 / H87　靴28cm' },
          ].map((item) => (
            <div class="flex justify-between px-5 py-3">
              <span class="font-display text-xs tracking-widest text-[var(--color-ink-muted)]">{item.label}</span>
              <span class="font-japanese text-sm text-[var(--color-ink)] text-right">{item.value}</span>
            </div>
          ))}
        </div>

        <!-- Skills & Qualifications -->
        <div class="mt-6">
          <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">SKILLS & QUALIFICATIONS</p>
          <ul class="space-y-2 font-japanese text-sm text-[var(--color-ink-muted)] leading-relaxed">
            <li>珠算 六段 ／ 暗算 八段</li>
            <li>将棋 全国大会出場</li>
            <li>実用英語技能検定 準一級</li>
            <li>ピアノ</li>
            <li>野球（高校）・テニス</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Okinawa photo -->
    <section class="mb-20 grid md:grid-cols-2 border border-[var(--color-border)] overflow-hidden">
      <!-- Photo: natural portrait ratio -->
      <div class="overflow-hidden">
        <Image
          src={imgMap['/写真、画像/my portfolio/okinawa.jpg']}
          alt="Okinawa, Japan"
          width={1200}
          class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
        />
      </div>
      <!-- Location info -->
      <div class="flex flex-col justify-center px-10 py-12 bg-[var(--color-cream-dark)] space-y-6">
        <div>
          <span class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] block mb-3">LOCATION</span>
          <h3 class="font-display text-3xl tracking-[0.15em] text-[var(--color-ink)]">OKINAWA<br />JAPAN</h3>
        </div>
        <div class="h-px w-12 bg-[var(--color-gold)]"></div>
        <p class="font-japanese text-[var(--color-ink-muted)] leading-loose text-sm">
          沖縄を拠点に、俳優・医学生として活動中。
          島の文化と人々から、日々エネルギーをもらっています。
        </p>
      </div>
    </section>

    <!-- Credits -->
    <section class="mb-20 fade-in">
      <header class="mb-10">
        <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">出演歴</p>
        <h2 class="font-display text-3xl tracking-[0.15em] text-[var(--color-ink)] mb-4">CREDITS</h2>
        <div class="h-px w-16 bg-[var(--color-gold)]"></div>
      </header>

      {[
        {
          year: '2026',
          items: [
            { title: '島守のうた（神戸公演）', role: '浦崎純 役', category: '舞台', href: '/works/shimamori' },
            { title: '地域を応援する演劇 Season 1「南風原の食堂の物語」', role: '出演・脚本', category: '舞台', href: '/works/chiiki' },
            { title: '月桃物語 かりゆしウェア（2年目）', role: 'モデル', category: 'モデル', href: '/works/pipes' },
          ],
        },
        {
          year: '2025',
          items: [
            { title: '一人芝居：伊藤駿一の奇劇', role: '作・演出・出演', category: '舞台', href: '/works/hitorigei' },
            { title: 'みんながサンタ！（4年目）', role: '企画・運営・出演', category: 'チャリティー', href: '/works/santa' },
            { title: '喜劇 カムカンボブッター', role: '高田 役', category: '舞台', href: null },
            { title: '月桃物語 かりゆしウェア（初年度）', role: 'モデル', category: 'モデル', href: '/works/pipes' },
            { title: '戦場のランチタイム（再現VTR）', role: '野田 役', category: 'TV', href: null },
            { title: 'ラジオドラマ「80年目の帰郷」', role: '日本兵 役', category: 'ラジオ', href: null },
          ],
        },
        {
          year: '2024',
          items: [
            { title: 'ザ・リバース 〜THE REBIRTH〜', role: '工藤 役（主演）', category: '舞台', href: '/works/rebirth' },
            { title: 'サンタがくれたクリスマスケーキ', role: 'サンタ 役（主演）', category: '舞台', href: null },
            { title: 'CITIZENs〜戦わないという選択〜', role: 'エキストラ・スタッフ', category: '映画', href: '/works/citizens' },
            { title: '新・海外旅行保険OFF 紹介ビデオ（BOVA出品）', role: '主演', category: 'CM', href: null },
            { title: '琉球トラウマナイトリアルストーリー「ゆびわ」', role: '山城 役', category: 'TV', href: null },
            { title: 'Aランチ コワイハナシ 答えの先は自己責任 Ep.2', role: '犯人 役', category: 'TV', href: null },
          ],
        },
        {
          year: '2023',
          items: [
            { title: '末期色の国', role: 'ニーチェ 役', category: '舞台', href: null },
            { title: '介護喜劇 心の花', role: '医者 役', category: '舞台', href: null },
            { title: 'キネマの天地', role: '小倉 役', category: '舞台', href: null },
            { title: '猫好きが集まる猫演劇 ザ・キャット', role: '先生 役', category: '舞台', href: null },
            { title: 'POVO「ギガない太陽」', role: '主演', category: 'CM', href: null },
          ],
        },
        {
          year: '2022',
          items: [
            { title: 'オカマバー TENDER', role: '小林 役', category: '舞台', href: null },
            { title: '若者のすべて', role: '直樹 役', category: '舞台', href: null },
            { title: 'みんながサンタ！（初年度〜）', role: '企画・出演', category: 'チャリティー', href: '/works/santa' },
          ],
        },
      ].map(({ year, items }) => (
        <div class="mb-10">
          <div class="flex items-center gap-4 mb-4">
            <span class="font-display text-sm tracking-[0.3em] text-[var(--color-gold)]">{year}</span>
            <div class="h-px flex-1 bg-[var(--color-border)]"></div>
          </div>
          <div class="divide-y divide-[var(--color-border)]">
            {items.map((item) => (
              <div class="py-3 flex items-baseline gap-4">
                <span class="font-display text-[10px] tracking-widest text-[var(--color-ink-muted)] border border-[var(--color-border)] px-2 py-0.5 shrink-0">{item.category}</span>
                {item.href ? (
                  <a href={item.href} class="font-japanese text-sm text-[var(--color-ink)] hover:text-[var(--color-gold-dark)] transition-colors flex-1">{item.title}</a>
                ) : (
                  <span class="font-japanese text-sm text-[var(--color-ink)] flex-1">{item.title}</span>
                )}
                <span class="font-japanese text-xs text-[var(--color-ink-muted)] shrink-0">{item.role}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Contact CTA -->
    <section class="text-center border border-[var(--color-border)] bg-white p-12 space-y-6">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)]">CONTACT</p>
      <p class="font-japanese text-[var(--color-ink-muted)] leading-loose">
        出演依頼・取材・その他お問い合わせはこちら
      </p>
      <a
        href="mailto:changeupandshake@gmail.com"
        class="inline-block px-8 py-3 border border-[var(--color-gold)] text-[var(--color-gold)] font-display text-xs tracking-[0.2em] hover:bg-[var(--color-gold)] hover:text-white transition-all duration-300"
      >
        SEND EMAIL
      </a>
    </section>
  </div>
</Layout>
