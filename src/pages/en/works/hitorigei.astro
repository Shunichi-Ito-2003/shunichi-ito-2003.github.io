---
import Layout from '../../../layouts/Layout.astro';
import { getPostsByKeyword } from '../../../lib/posts';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/写真、画像/**/*.{jpg,JPG,jpeg,JPEG,png,PNG}'
, { eager: true });

const imgMap: Record<string, ImageMetadata> = {};
for (const [fullPath, mod] of Object.entries(allImages)) {
  imgMap[fullPath.replace('/src/assets', '')] = mod.default;
}

const relatedPosts = getPostsByKeyword('一人芝居').slice(0, 8);

const highlights = [
  { date: '2025.02', text: 'The decision to perform solo. Writing, directing, and performing — all alone.' },
  { date: '2025.03', text: 'Scriptwriting begins. Facing what lies inside and turning it into words.' },
  { date: '2025.04', text: 'World premiere at Chatan Mods. A full house of 88 — delivering a one-man show.' },
  { date: '2026〜', text: '"Traveling Solo Performance" launches. Available anywhere in Okinawa, for even one person.' },
];
---

<Layout
  title="Ito Shunichi no Kigeki"
  description="Shunichi Ito's solo performance 'Ito Shunichi no Kigeki' — writing, directing, and performing all alone. World premiere at Chatan Mods, full house of 88. Now touring Okinawa as a traveling solo show."
>
  <!-- Hero -->
  <section class="relative h-[70vh] overflow-hidden bg-[var(--color-ink)]">
    <Image src={imgMap['/写真、画像/一人芝居/劇中の僕.JPG']} alt="Ito Shunichi no Kigeki" width={1920} loading="eager" class="w-full h-full object-cover" style="object-position: 50% 18%" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 p-8 md:p-16 max-w-4xl">
      <a href="/en/works" class="font-display text-xs tracking-[0.2em] text-white/50 hover:text-[var(--color-gold)] transition-colors mb-6 block">← Works</a>
      <span class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] block mb-3">SOLO PERFORMANCE · 2025〜</span>
      <h1 class="font-japanese text-4xl md:text-6xl font-bold text-white leading-tight mb-4">伊藤駿一の奇劇</h1>
      <p class="text-sm text-white/70 leading-relaxed">Written, directed, and performed — all by one</p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6 py-16 space-y-20">

    <!-- Overview -->
    <section class="fade-in grid md:grid-cols-[1fr_280px] gap-12">
      <div class="space-y-6">
        <div>
          <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">OVERVIEW</p>
          <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-6">About the work</h2>
        </div>
        <div class="space-y-4 text-sm text-[var(--color-ink-muted)] leading-loose text-justify">
          <p>
            Writing the script, shaping the direction, standing on stage — all carried by one person. Solo performance is not simply "acting." It is a form of creation where every choice becomes a question asked of oneself.
          </p>
          <p>
            In April 2025, the world premiere took place at Chatan Mods. A full house of 88 — the story told by one person filled the room.
          </p>
          <p>
            From 2026, the <strong class="text-[var(--color-ink)]">"Traveling Solo Performance"</strong> project began: performing anywhere in Okinawa, for even a single person. Theater should not require a special destination — it should arrive in daily life.
          </p>
        </div>
      </div>

      <div class="border border-[var(--color-border)] divide-y divide-[var(--color-border)] h-fit">
        {[
          { label: 'ROLE', value: 'Writer / Director / Performer (Shunichi Ito)' },
          { label: 'PREMIERE', value: 'April 2025 — Chatan Mods (Full house, 88)' },
          { label: 'FORMAT', value: 'Traveling Solo Performance (from 2026)' },
          { label: 'AREA', value: 'Okinawa Main Island / From 1 person' },
        ].map((item) => (
          <div class="px-5 py-3">
            <p class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] mb-0.5">{item.label}</p>
            <p class="text-sm text-[var(--color-ink)]">{item.value}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- My role -->
    <section class="fade-in border-l-2 border-[var(--color-gold)] pl-8 space-y-4">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)]">MY ROLE</p>
      <h2 class="font-display text-xl text-[var(--color-ink)]">"Creating" deepens "performing"</h2>
      <div class="space-y-4 text-sm text-[var(--color-ink-muted)] leading-loose text-justify">
        <p>
          Solo performance is not complete with acting alone. What story to tell, which words are needed, how to use the space — every decision turns back as a question. That is the work.
        </p>
        <p>
          Writing the script revealed emotions in characters I had not yet noticed. Thinking through direction opened possibilities in the stage I had not seen. These discoveries made the act of performing richer and deeper.
        </p>
        <p>
          My belief that "theater brings peace to the world" does not stop at the theater stage. Delivering solo performance into someone's daily life is the practice of that belief.
        </p>
      </div>
    </section>

    <!-- Flyer -->
    <section class="fade-in">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">FLYER</p>
      <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-6">Production flyer</h2>
      <div class="flex justify-center">
        <Image
          src={imgMap['/写真、画像/一人芝居/伊藤駿一の奇劇_フライヤー_初めての一人芝居.PNG']}
          alt="Ito Shunichi no Kigeki — Flyer"
          width={768}
          class="max-w-sm w-full border border-[var(--color-border)]"
        />
      </div>
    </section>

    <!-- Gallery -->
    <section class="fade-in">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">GALLERY</p>
      <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-6">Photos</h2>
      <div class="grid grid-cols-1 gap-4">
        <Image
          src={imgMap['/写真、画像/一人芝居/劇中の僕.JPG']}
          alt="Ito Shunichi no Kigeki — performance"
          width={1200}
          class="w-full border border-[var(--color-border)]"
        />
      </div>
    </section>

    <!-- Video -->
    <section class="fade-in border border-[var(--color-border)] p-8 text-center space-y-3">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)]">VIDEO</p>
      <p class="text-sm text-[var(--color-ink-muted)] leading-relaxed">
        Video available on request
      </p>
      <a
        href="mailto:changeupandshake@gmail.com"
        class="inline-block font-display text-xs tracking-[0.2em] text-[var(--color-gold)] hover:underline"
      >
        CONTACT →
      </a>
    </section>

    <!-- Timeline -->
    <section class="fade-in">
      <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">TIMELINE</p>
      <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-8">Record</h2>
      <div class="relative pl-6 border-l-2 border-[var(--color-border)] space-y-0">
        {highlights.map((h) => (
          <div class="relative py-5 group">
            <div class="absolute -left-[1.45rem] top-7 w-3 h-3 rounded-full border-2 border-[var(--color-gold)] bg-white group-hover:bg-[var(--color-gold)] transition-colors"></div>
            <time class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] block mb-1">{h.date}</time>
            <p class="text-sm text-[var(--color-ink)] leading-relaxed">{h.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related posts -->
    {relatedPosts.length > 0 && (
      <section class="fade-in">
        <p class="font-display text-xs tracking-[0.3em] text-[var(--color-gold)] mb-3">DOCUMENT</p>
        <h2 class="font-display text-2xl tracking-widest text-[var(--color-ink)] mb-4">Production journal</h2>
        <p class="text-xs text-[var(--color-ink-muted)] mb-8">* Written in Japanese</p>
        <div class="divide-y divide-[var(--color-border)]">
          {relatedPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="group flex gap-6 py-5 hover:bg-[var(--color-cream)] px-2 -mx-2 transition-colors">
              <time class="font-display text-xs tracking-widest text-[var(--color-ink-muted)] shrink-0 pt-1 w-24">{post.date}</time>
              <h3 class="font-japanese text-[var(--color-ink)] group-hover:text-[var(--color-gold-dark)] transition-colors leading-relaxed line-clamp-2">{post.title}</h3>
              <span class="shrink-0 self-center font-display text-xs text-[var(--color-gold)] opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
